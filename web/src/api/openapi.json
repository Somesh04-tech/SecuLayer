    "/api/schema/run-event": {
      "get": {
        "description": "Schema only: puts the run-event union into OpenAPI for the frontend's generated types.",
        "operationId": "run_event_schema_api_schema_run_event_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "discriminator": {
                      "mapping": {
                        "attacker.event": "#/components/schemas/AttackerEvent",
                        "layer.started": "#/components/schemas/LayerStarted",
                        "layer.verdict": "#/components/schemas/LayerVerdict",
                        "model.request": "#/components/schemas/ModelRequest",
                        "model.response": "#/components/schemas/ModelResponse",
                        "run.error": "#/components/schemas/RunError",
                        "run.finished": "#/components/schemas/RunFinished",
                        "run.paused": "#/components/schemas/RunPaused",
                        "run.started": "#/components/schemas/RunStarted",
                        "tool.decision": "#/components/schemas/ToolDecision",
                        "tool.proposed": "#/components/schemas/ToolProposed",
                        "tool.result": "#/components/schemas/ToolResult"
                      },
                      "propertyName": "type"
                    },
                    "oneOf": [
                      {
                        "$ref": "#/components/schemas/RunStarted"
                      },
                      {
                        "$ref": "#/components/schemas/LayerStarted"
                      },
                      {
                        "$ref": "#/components/schemas/LayerVerdict"
                      },
                      {
                        "$ref": "#/components/schemas/ModelRequest"
                      },
                      {
                        "$ref": "#/components/schemas/ModelResponse"
                      },
                      {
                        "$ref": "#/components/schemas/ToolProposed"
                      },
                      {
                        "$ref": "#/components/schemas/ToolDecision"
                      },
                      {
                        "$ref": "#/components/schemas/RunPaused"
                      },
                      {
                        "$ref": "#/components/schemas/ToolResult"
                      },
                      {
                        "$ref": "#/components/schemas/AttackerEvent"
                      },
                      {
                        "$ref": "#/components/schemas/RunFinished"
                      },
                      {
                        "$ref": "#/components/schemas/RunError"
                      }
                    ]
                  },
                  "title": "Response Run Event Schema Api Schema Run Event Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Run Event Schema"
      }
    },
    "/api/screen": {
      "post": {
        "description": "Layers 1-2 on the viewer's text, locally: no model call, so the judge is off.",
