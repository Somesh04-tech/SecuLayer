# Copy to .env and fill in. .env is gitignored. Never commit a real key.

# Needed only for live mode, record, eval-live and doctor --online.
OPENAI_API_KEY=

# replay (default, offline) or live. ./run.sh --live sets it.
SECULAYER_MODE=replay

# Target model on both sides, the stronger-model comparison, and the LLM judge.
SECULAYER_MODEL=gpt-5.4-mini-2026-03-17
SECULAYER_COMPARE_MODEL=gpt-5.4-2026-03-05
SECULAYER_JUDGE_MODEL=gpt-5.4-mini-2026-03-17

# Where the server listens. The host must stay a loopback address.
SECULAYER_HOST=127.0.0.1
SECULAYER_PORT=8765

# Cap on total tokens used by live calls, as logged in data/spend.jsonl.
# Set it to the free tier's limit.
SECULAYER_TOKEN_BUDGET=1500000

# Classifier files.
SECULAYER_CLASSIFIER_DIR=models/prompt-guard-2-22m

# debug, info, warning or error. Logs never include full prompts or the key.
SECULAYER_LOG_LEVEL=info

# Caches stay on the external drive. run.sh and the Makefile set these to
# <repo>/.cache/... automatically; set them here only to override.
# UV_CACHE_DIR=
# npm_config_cache=
# PLAYWRIGHT_BROWSERS_PATH=
